# 默认 provider(目前仅 agnes)
MEDIA_PROVIDER=agnes

# —— Agnes provider ——
AGNES_API_KEY=sk-your-agnes-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Agnes 视频提交限速(实测 1 req/min,留 2s 余量)
AGNES_VIDEO_MIN_INTERVAL_MS=62000

# —— 通用 ——
# 产物落盘目录(图片/视频)
OUT_DIR=./output

# 视频轮询默认参数
VIDEO_TIMEOUT_MS=900000
VIDEO_POLL_INTERVAL_MS=10000
