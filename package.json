{
  "name": "media-gen-mcp-server",
  "version": "0.3.4",
  "description": "All-in-one image-generation MCP server for Claude Code: AI imagery/video (Agnes AI + Zhipu) + structured local rendering (diagrams, charts, formulas, cards, icons, QR codes). Provider- and engine-pluggable.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "media-gen-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && chmod +x dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "agnes-ai",
    "image-generation",
    "video-generation",
    "model-context-protocol"
  ],
  "license": "MIT",
  "homepage": "https://github.com/wangdong233/media-gen-mcp",
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@resvg/resvg-js": "^2.6.2",
    "@terrastruct/d2": "^0.1.33",
    "@viz-js/viz": "^3.28.0",
    "mathjax-full": "^3.2.1",
    "qrcode": "^1.5.4",
    "satori": "^0.10.14",
    "vega": "^5.30.0",
    "vega-lite": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.0"
  },
  "author": "wangdong <w11201413@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangdong233/media-gen-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/wangdong233/media-gen-mcp/issues"
  }
}
