{
  "name": "media-gen-mcp-server",
  "version": "0.13.0",
  "description": "All-in-one image-generation MCP server for Claude Code: AI imagery/video (Agnes AI + Zhipu) + structured local rendering (diagrams, charts, formulas, cards, icons, QR codes). Provider- and engine-pluggable.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "media-gen-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:tests": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "npm run build && npm run build:tests && node --test dist-test/*.test.js test/*.mjs && node scripts/check-error-text.mjs && node scripts/check-schema.mjs && MEDIA_GEN_CHECK_PROFILE=strict node scripts/check-render-output.mjs test/golden/expected/qr/url.png",
    "render:golden": "npm run build && npm run build:tests && node scripts/render-golden.mjs",
    "check:render": "node scripts/check-render-output.mjs",
    "build:fixtures": "node scripts/build-p04-fixtures.mjs",
    "prepublishOnly": "npm run build && chmod +x dist/index.js && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "agnes-ai",
    "image-generation",
    "video-generation",
    "model-context-protocol"
  ],
  "license": "MIT",
  "homepage": "https://github.com/wangdong233/media-gen-mcp",
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@resvg/resvg-js": "^2.6.2",
    "@terrastruct/d2": "^0.1.33",
    "@viz-js/viz": "^3.28.0",
    "ffmpeg-static": "^5.3.0",
    "mathjax-full": "^3.2.1",
    "puppeteer-core": "^25.3.0",
    "qrcode": "^1.5.4",
    "satori": "^0.10.14",
    "tesseract.js": "^7.0.0",
    "vega": "^5.30.0",
    "vega-lite": "^5.22.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "^0.9.0",
    "jsqr": "^1.4.0",
    "pngjs": "^5.0.0",
    "typescript": "^5.6.0"
  },
  "author": "wangdong <w11201413@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangdong233/media-gen-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/wangdong233/media-gen-mcp/issues"
  }
}
