{
  "defaultProvider": "agnes",
  "defaultImageProvider": "agnes",
  "defaultVideoProvider": "zhipu",
  "_providerPriorityNote": "渠道优先级链:imageProviderPriority/videoProviderPriority = [head, ...fallback 顺序],链头失败(限流/5xx)时按序惰性回落;显式传 provider 或 model 则钉死该渠道不回落。不配置这两项 = 现行为(defaultImageProvider/defaultVideoProvider + agnes/zhipu 免费层自动 fallback)。env 等价:MEDIA_IMAGE_PROVIDER_PRIORITY=\"agnes,zhipu\" / MEDIA_VIDEO_PROVIDER_PRIORITY。注:Google Flow 渠道已分离为独立包 flow-mcp(github.com/wangdong233/flow-mcp),与本包共享本配置文件(其开关/路由偏好见该包的 flow 段);在本包链里写 \"flow\" 会被剔除并告警。",
  "imageProviderPriority": [
    "agnes",
    "zhipu"
  ],
  "videoProviderPriority": [
    "agnes",
    "zhipu"
  ],
  "rateLimitTtlMs": 604800000,
  "providers": {
    "agnes": {
      "apiKey": "sk-your-key-here",
      "videoMinIntervalMs": 62000,
      "models": {
        "image": {
          "default": "agnes-image-2.1-flash",
          "available": [
            "agnes-image-2.0-flash",
            "agnes-image-2.1-flash"
          ]
        },
        "video": {
          "default": "agnes-video-v2.0",
          "available": [
            "agnes-video-v2.0"
          ]
        }
      },
      "rateLimits": {}
    },
    "zhipu": {
      "apiKey": "your-zhipu-api-key",
      "baseUrl": "https://open.bigmodel.cn/api",
      "videoMinIntervalMs": 62000,
      "models": {
        "image": {
          "default": "cogview-3-flash",
          "available": [
            "cogview-3-flash",
            "cogview-4",
            "cogview-4-250304",
            "glm-image"
          ]
        },
        "video": {
          "default": "cogvideox-flash",
          "available": [
            "cogvideox-flash",
            "cogvideox-2",
            "cogvideox-3"
          ]
        }
      },
      "rateLimits": {}
    }
  }
}
